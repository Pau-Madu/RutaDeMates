{
  "name": "ruta-de-mates",
  "private": true,
  "description": "Ruta de Mates: app de exámenes de Matemáticas CCSS II (Firebase Hosting + Firestore).",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-ruta-de-mates",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ruta-de-mates \"node --test tests/rules.test.cjs\"",
    "deploy": "firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "13.29.1"
  }
}
